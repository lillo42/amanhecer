<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(AmanhecerTargetFrameworks)</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <Description>Generic-host integration for Amanhecer: runs the messaging gateway consumers as a hosted service alongside the host.</Description>
        <PackageTags>mediator;cqrs;messaging;dispatcher;hosting;hosted-service;generic-host;middleware;pipeline</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Amanhecer.Abstractions\Amanhecer.Abstractions.csproj"/>
        <ProjectReference Include="..\Amanhecer\Amanhecer.csproj"/>
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    </ItemGroup>
</Project>

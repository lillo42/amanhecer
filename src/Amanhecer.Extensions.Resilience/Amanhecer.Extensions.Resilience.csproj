<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(AmanhecerTargetFrameworks)</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <Description>Microsoft.Extensions.Resilience integration for Amanhecer: execute request pipelines inside named resilience pipelines with request-metadata telemetry enrichment.</Description>
        <PackageTags>mediator;cqrs;messaging;dispatcher;resilience;retry;circuit-breaker;timeout;telemetry;middleware;pipeline</PackageTags>

        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net462'">
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Amanhecer.Abstractions\Amanhecer.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Resilience" />
    </ItemGroup>

</Project>

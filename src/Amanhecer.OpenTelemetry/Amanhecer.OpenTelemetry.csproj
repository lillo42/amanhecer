<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(AmanhecerTargetFrameworks)</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <Description>OpenTelemetry integration for Amanhecer: trace and metric instrumentation for the request pipelines.</Description>
        <PackageTags>mediator;cqrs;messaging;dispatcher;opentelemetry;observability;tracing;metrics</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="OpenTelemetry" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Amanhecer\Amanhecer.csproj" />
    </ItemGroup>

</Project>

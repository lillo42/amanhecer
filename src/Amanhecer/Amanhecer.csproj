<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <TargetFrameworks>$(AmanhecerTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>A lightweight request dispatcher (mediator) for .NET — send commands, publish events and execute queries through middleware pipelines. Inspired by Paramore Brighter.</Description>
    <PackageTags>mediator;cqrs;messaging;dispatcher;commands;events;queries;middleware;pipeline;brighter</PackageTags>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Amanhecer.Abstractions\Amanhecer.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net462'">
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(AmanhecerTargetFrameworks)</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <Description>Microsoft.Extensions.Resilience integration for Amanhencer: execute request pipelines inside named resilience pipelines with request-metadata telemetry enrichment.</Description>
        <PackageTags>mediator;cqrs;messaging;dispatcher;resilience;retry;circuit-breaker;timeout;telemetry;middleware;pipeline;brighter</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Amanhencer.Abstractions\Amanhencer.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Resilience" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(AmanhecerTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>OpenTelemetry integration for Amanhencer: trace and metric instrumentation for the request pipelines.</Description>
        <PackageTags>mediator;cqrs;messaging;dispatcher;opentelemetry;observability;tracing;metrics;brighter</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="OpenTelemetry" />
      <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Amanhencer\Amanhencer.csproj" />
    </ItemGroup>

</Project>

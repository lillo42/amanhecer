<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(AmanhecerTargetFrameworks)</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <Description>Polly integration for Amanhencer: execute request pipelines inside named Polly resilience pipelines (retry, circuit breaker, timeout, fallback) via middleware.</Description>
        <PackageTags>mediator;cqrs;messaging;dispatcher;polly;resilience;retry;circuit-breaker;timeout;middleware;pipeline;brighter</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Amanhencer.Abstractions\Amanhencer.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Polly.Core" />
    </ItemGroup>

</Project>
